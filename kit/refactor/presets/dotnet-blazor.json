{
  "sourceGlobs": [
    "**/*.cs",
    "**/*.razor"
  ],
  "excludeGlobs": [
    "**/bin/**",
    "**/obj/**",
    "**/Migrations/**",
    "**/node_modules/**",
    "**/wwwroot/lib/**",
    "**/_to_delete/**"
  ],
  "maxFileLines": 100,
  "maxFunctionLines": 30,
  "fileLengthExemptGlobs": [
    "**/GlobalUsings.cs",
    "**/*.Designer.cs"
  ],
  "booleanPrefixes": ["is", "has", "should", "can", "was", "will", "must", "allows"],
  "bannedAbbreviations": [
    "usr", "btn", "cfg", "tmp", "req", "res", "ctx", "idx", "err", "msg", "num", "val", "cnt", "arr", "obj2", "fn"
  ],
  "commentMarkers": {
    "line": "//",
    "documentation": "///",
    "markup": "@*"
  },
  "duplication": {
    "minTokens": 70,
    "ignoreGlobs": ["**/bin/**", "**/obj/**", "**/Migrations/**"]
  },
  "inventory": {
    "pagesGlob": "**/Pages/**/*.razor",
    "componentsGlob": "**/Components/**/*.razor",
    "widgetMarkers": {
      "table": "<table",
      "modal": "Modal",
      "form": "FormField",
      "loadGate": "LoadGate",
      "spinner": "Spinner",
      "toast": "toast",
      "dropdown": "DropdownMenu",
      "panel": "Panel",
      "export": "ExportToExcelButton"
    }
  },
  "styleTokens": {
    "markupGlobs": ["**/*.razor", "**/*.css"],
    "forbidInlineHexColours": true,
    "forbidInlineStyleAttributes": true
  },
  "prose": {
    "maxMemberChainDepth": 1,
    "freeChainPrefixes": ["this.", "base.", "self.", "import.meta."],
    "maxLineLength": 160,
    "maxIndentDepth": 5,
    "indentWidth": 4,
    "indentedFileGlobs": ["**/*.cs"]
  },
  "frameworkHandlers": {
    "namePatterns": ["^on[A-Z]", "^handle[A-Z]", "^On[A-Z]", "^Handle[A-Z]"],
    "names": [],
    "coincidenceLines": 12
  },
  "functionNames": {
    "maxWords": 5,
    "maxLength": 40
  },
  "areas": [
    {"name": "tests", "globs": ["**/*.test.*", "**/*.spec.*", "**/tests/**", "**/Tests/**", "**/*.Tests/**", "**/*Tests.cs"]},
    {"name": "docs", "globs": ["**/*.md", "docs/**"]},
    {"name": "tooling", "globs": ["tools/**", ".claude/**", "scripts/**"]},
    {"name": "database", "globs": ["**/Migrations/**", "**/*.sql"]},
    {"name": "api", "globs": ["**/Controllers/**", "**/Endpoints/**", "**/Api/**", "**/Functions/**", "**/Ai/**"]},
    {"name": "frontend", "globs": ["**/*.razor", "**/*.razor.cs", "**/*.razor.css", "**/wwwroot/**", "**/*.css", "**/*.js"]},
    {"name": "backend", "globs": ["**/*.cs"]},
    {"name": "infrastructure", "globs": ["infra/**", "**/*.bicep", ".github/**", "**/*.csproj", "**/*.sln", "*.json", "*.yml", "*.yaml", ".*"]}
  ],
  "designPatterns": {
    "entityGlobs": ["**/Domain/**/*.cs", "**/Entities/**/*.cs", "**/Models/**/*.cs"],
    "minimumFamilySize": 4,
    "cooccurrenceThreshold": 0.75,
    "fileCountBand": 2.0,
    "acceptedGaps": []
  },
  "siteDefinition": {
    "viewGlobs": ["**/*.razor"],
    "ignoredTags": ["PageTitle", "HeadContent"],
    "catalogue": [],
    "handRolled": [
      {"element": "table", "ownedBy": "RecordsTable"},
      {"element": "input", "ownedBy": "FormField", "unlessAttributes": ["type=\"checkbox\"", "type=\"radio\"", "type=\"file\"", "type=\"hidden\""]},
      {"element": "select", "ownedBy": "FormField"},
      {"element": "textarea", "ownedBy": "FormField"},
      {"element": "h1", "ownedBy": "PageHeader"},
      {"element": "h2", "ownedBy": "SectionHeader"},
      {"element": "h3", "ownedBy": "SectionHeader"}
    ],
    "horizontalClasses": ["flex", "inline-flex"],
    "verticalClasses": ["flex-col"],
    "document": "tools/refactor/site-definition.md"
  },
  "inputValidation": {
    "schemaGlobs": ["**/Migrations/*.cs", "**/*.sql"],
    "entryPointGlobs": ["**/Controllers/**/*.cs", "**/*Controller.cs", "**/Endpoints/**/*.cs", "**/*Endpoints.cs", "**/*Handler.cs", "**/Mcp/**/*.cs", "**/*Tools.cs", "**/Pages/**/*.razor", "**/Components/**/*.razor", "**/*.razor.cs", "**/Program.cs"],
    "writePatterns": ["\\.(?P<table>\\w+)\\s*\\.\\s*(?:Add|AddRange|AddAsync|AddRangeAsync|Update|UpdateRange|Attach)\\(", "insert\\s+into\\s+(?:\\w+\\.)?[\\\"`\\[]?(?P<table>\\w+)", "\\bupdate\\s+(?:\\w+\\.)?[\\\"`\\[]?(?P<table>\\w+)[\\\"`\\]]?\\s+set\\b"],
    "validatorPatterns": ["AbstractValidator<", "\\bRuleFor\\(", "\\[(?:MaxLength|StringLength|Range|Required|RegularExpression|EmailAddress)\\b", "DataAnnotationsValidator", "FluentValidationValidator", "Validator\\.TryValidateObject", "\\.ValidateAsync\\(", "\\.Validate\\(", "ValidateAndThrow"],
    "exemptGlobs": ["**/Migrations/**"]
  },
  "score": {
    "elements": {}
  }
}
